" y="283.0" as="offset" /></mxGeometry></mxCell><mxCell id="fk_assignment_group" parent="1" value="[4] 1 : 0..N" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#2765A6;strokeWidth=2;fontColor=#2765A6;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.75;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" source="groups_id" target="assignments_group_id"><mxGeometry relative="1" as="geometry" x="0" y="0"><Array as="points"><mxPoint x="680" y="1028" /><mxPoint x="680" y="1500" /><mxPoint x="1720" y="1500" /><mxPoint x="1720" y="1340.0" /></Array><mxPoint x="161.0" y="0.0" as="offset" /></mxGeometry></mxCell><mxCell id="fk_assignment_student" parent="1" value="[5] 1 : 0..N" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#087E83;strokeWidth=2;fontColor=#087E83;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.75;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" source="users_id" target="assignments_student_id"><mxGeometry relative="1" as="geometry" x="0" y="0"><Array as="points"><mxPoint x="860" y="308" /><mxPoint x="860" y="1372.0" /></Array><mxPoint x="0.0" y="375.0" as="offset" /></mxGeometry></mxCell><mxCell id="fk_submission_assignment" parent="1" value="[6] 1 : 0..N" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#2765A6;strokeWidth=2;fontColor=#2765A6;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" source="assignments_id" target="submissions_assignment_id"><mxGeometry relative="1" as="geometry" x="0" y="0"><Array as="points"><mxPoint x="1740" y="1020" /><mxPoint x="1740" y="332" /></Array><mxPoint x="0.0" y="174.0" as="offset" /></mxGeometry></mxCell><mxCell id="fk_submission_student" parent="1" value="[7] 1 : 0..N" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#6F57A6;strokeWidth=2;fontColor=#6F57A6;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" source="users_id" target="submissions_student_id"><mxGeometry relative="1" as="geometry" x="0" y="0"><Array as="points"><mxPoint x="1060" y="284" /><mxPoint x="1060" y="364" /></Array><mxPoint x="175.0" y="41.0" as="offset" /></mxGeometry></mxCell><mxCell id="fk_submission_curator" parent="1" value="[8] 1 : 0..N" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#3A7950;strokeWidth=2;fontColor=#3A7950;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.125;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" source="users_id" target="submissions_curator_id"><mxGeometry relative="1" as="geometry" x="0" y="0"><Array as="points"><mxPoint x="1000" y="288" /><mxPoint x="1000" y="588" /></Array><mxPoint x="5.0" y="242.0" as="offset" /></mxGeometry></mxCell><mxCell id="users_rules" parent="1" value="&lt;b&gt;Пользователи&lt;/b&gt;&lt;br&gt;&lt;br&gt;role IN (student, curator, admin). У студента group_id заполнен, у остальных ролей — NULL.&lt;br&gt;UQ*: отдельные уникальные индексы lower(btrim(login)) и lower(btrim(email)); оба поля непустые.&lt;br&gt;NOT NULL указан явно. Все четыре id — int IDENTITY." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="90" y="600" width="460" height="230" as="geometry" /></mxCell><mxCell id="group_rules" parent="1" value="&lt;b&gt;Группы&lt;/b&gt;&lt;br&gt;&lt;br&gt;Один курс практики = одна группа. end_date ≥ start_date.&lt;br&gt;curator_id обязателен и указывает пользователя с ролью curator.&lt;br&gt;Список студентов: Users WHERE group_id = Groups.id." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="90" y="1230" width="460" height="200" as="geometry" /></mxCell><mxCell id="submission_rules" parent="1" value="&lt;b&gt;Сдача и файл&lt;/b&gt;&lt;br&gt;&lt;br&gt;UNIQUE (assignment_id, student_id). Оба FK обязательны.&lt;br&gt;file_data bytea: 1–20 000 000 байт. Списки не выбирают file_data." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="1140" y="800" width="460" height="160" as="geometry" /></mxCell><mxCell id="edge_key" parent="1" value="&lt;b&gt;Номера связей: FK → PK&lt;/b&gt;&lt;br&gt;&lt;br&gt;[1] Groups.curator_id → Users.id; [2] Users.group_id → Groups.id.&lt;br&gt;[3] Assignments.curator_id → Users.id; [4] Assignments.group_id → Groups.id.&lt;br&gt;[5] Assignments.student_id → Users.id; [6] Submissions.assignment_id → Assignments.id.&lt;br&gt;[7] Submissions.student_id → Users.id; [8] Submissions.curator_id → Users.id.&lt;br&gt;У каждого FK: ON DELETE RESTRICT, ON UPDATE RESTRICT. Правила роли/доступа реализует сервер." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="90" y="1570" width="960" height="230" as="geometry" /></mxCell><mxCell id="assignment_rules" parent="1" value="&lt;b&gt;Задания и публикация&lt;/b&gt;&lt;br&gt;&lt;br&gt;group_id и student_id не заполняются вместе. В published нужен один получатель; в draft он необязателен.&lt;br&gt;Результат: score, feedback, decision, graded_at, result_published_at — до проверки могут быть NULL.&lt;br&gt;Типы времени — timestamptz; календарные сроки группы — date." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="1140" y="1570" width="460" height="230" as="geometry" /></mxCell><mxCell id="validation_rule" parent="1" value="Все CHECK, индексы и правила состояния перечислены на вкладке «Правила БД». Диаграмма описывает модель; ограничения должны быть реализованы миграциями PostgreSQL." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=15;fontColor=#243A4B;" vertex="1"><mxGeometry x="60" y="1830" width="1800" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram>
  <diagram id="db-review-rules" name="Правила БД">
    <mxGraphModel dx="2460" dy="2030" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2460" pageHeight="2030" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" value="Правила БД для MVP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=28;fontColor=#243A4B;fontStyle=1;" vertex="1"><mxGeometry x="60" y="25" width="2340" height="45" as="geometry" /></mxCell><mxCell id="subtitle" parent="1" value="Редакция 16.11.2026 · PostgreSQL · 4 таблицы · 42 поля · 8 внешних ключей" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="60" y="78" width="2340" height="28" as="geometry" /></mxCell><mxCell id="legend" parent="1" value="Стрелка: PK → FK. 1 : 0..N — у одной записи может быть много связанных. NULL — поле необязательно; NOT NULL — обязательно. UQ* — уникальность без учёта регистра." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=14;fontColor=#243A4B;" vertex="1"><mxGeometry x="60" y="115" width="2340" height="48" as="geometry" /></mxCell><mxCell id="rules_users" parent="1" value="&lt;b&gt;1. Users и Groups: обязательность и роли&lt;/b&gt;&lt;br&gt;&lt;br&gt;Users.role NOT NULL CHECK (role IN (&amp;#x27;student&amp;#x27;,&amp;#x27;curator&amp;#x27;,&amp;#x27;admin&amp;#x27;)). CHECK ((role=&amp;#x27;student&amp;#x27; AND group_id IS NOT NULL) OR (role IN (&amp;#x27;curator&amp;#x27;,&amp;#x27;admin&amp;#x27;) AND group_id IS NULL)).&lt;br&gt;Полный состав группы находится по Users.group_id. Groups.student_id отсутствует. У студента одна группа; у группы один куратор и много студентов.&lt;br&gt;Groups: id, name, description, start_date, end_date, curator_id NOT NULL. CHECK (end_date &amp;gt;= start_date). Имя группы и full_name непустые.&lt;br&gt;Groups.curator_id и оба curator_id других таблиц ссылаются на Users.id. Роль curator и права проверяет сервис/триггер. Личные получатели и авторы сдач должны иметь роль student.&lt;br&gt;Создание: куратор без group_id → группа → студенты с group_id. Администратор назначает роли и группы; студент не меняет их сам.&lt;br&gt;Изменение роли, группы студента или куратора группы требует проверки действующих заданий, сдач и доступа в одной транзакции. До согласования процедуры такие изменения при связанных учебных данных блокируются." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="50" y="190" width="1150" height="420" as="geometry" /></mxCell><mxCell id="rules_assignments" parent="1" value="&lt;b&gt;2. Assignments: черновик и получатель&lt;/b&gt;&lt;br&gt;&lt;br&gt;status NOT NULL CHECK (status IN (&amp;#x27;draft&amp;#x27;,&amp;#x27;published&amp;#x27;)); type NOT NULL CHECK (type IN (&amp;#x27;task&amp;#x27;,&amp;#x27;report&amp;#x27;)). DEFAULT status=&amp;#x27;draft&amp;#x27;, type=&amp;#x27;task&amp;#x27;. title и curator_id NOT NULL; title непустой.&lt;br&gt;CHECK (group_id IS NULL OR student_id IS NULL). CHECK (status &amp;lt;&amp;gt; &amp;#x27;published&amp;#x27; OR group_id IS NOT NULL OR student_id IS NOT NULL). Вместе: draft — 0 или 1 получатель, published — ровно 1.&lt;br&gt;published требует description, deadline, criteria, published_at IS NOT NULL; description и criteria непустые. В draft эти поля могут отсутствовать.&lt;br&gt;CHECK ((status=&amp;#x27;draft&amp;#x27; AND published_at IS NULL) OR (status=&amp;#x27;published&amp;#x27; AND published_at IS NOT NULL)). При заполнении published_at &amp;gt;= created_at.&lt;br&gt;Сервис проверяет роль личного получателя, принадлежность группе куратора и права на выбранную группу. После публикации получателя не меняют; после первой сдачи не меняют type.&lt;br&gt;Одна строка адресована всей группе или одному студенту. Произвольный набор студентов одной строкой не поддерживается." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="1260" y="190" width="1150" height="420" as="geometry" /></mxCell><mxCell id="rules_submissions" parent="1" value="&lt;b&gt;3. Submissions: единственная отправка&lt;/b&gt;&lt;br&gt;&lt;br&gt;UNIQUE (assignment_id, student_id). Оба FK NOT NULL. Повторная отправка и замена файла после отправки в MVP отсутствуют.&lt;br&gt;status NOT NULL CHECK (status IN (&amp;#x27;submitted&amp;#x27;,&amp;#x27;under_review&amp;#x27;,&amp;#x27;revision_required&amp;#x27;,&amp;#x27;graded&amp;#x27;)). DEFAULT status=&amp;#x27;submitted&amp;#x27;. «Не сдано» и «Просрочено» вычисляются, отдельные строки для них не создаются.&lt;br&gt;При отправке сервер получает curator_id группы студента по Users.group_id → Groups.curator_id. curator_id NOT NULL; роль и права проверяет сервер. Клиент не выбирает проверяющего.&lt;br&gt;Сервис проверяет публикацию задания, его получателя, автора сдачи и правила дедлайна. Приём после дедлайна должен быть явно определён в API.&lt;br&gt;original_name, file_data, mime_type, size_bytes NOT NULL. Файл и строка сдачи сохраняются атомарно одной транзакцией; submitted_at задаёт сервер.&lt;br&gt;Отдельного uploaded_at нет: предзагрузка/черновик файла не предусмотрены. Повторный запрос не создаёт вторую строку. revision_required не разрешает пересдачу." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="50" y="640" width="1150" height="420" as="geometry" /></mxCell><mxCell id="rules_review" parent="1" value="&lt;b&gt;4. Результат: подготовка и публикация&lt;/b&gt;&lt;br&gt;&lt;br&gt;Пять nullable-полей результата: score, feedback, decision, graded_at, result_published_at. curator_id уже назначен при отправке и остаётся NOT NULL.&lt;br&gt;decision IS NULL → score, feedback, graded_at IS NULL. decision=accepted → score и graded_at IS NOT NULL. decision=revision_required → graded_at и непустой feedback IS NOT NULL. Иных decision нет.&lt;br&gt;submitted → все пять полей результата NULL. under_review → result_published_at IS NULL; результат отсутствует либо подготовлен по правилам decision.&lt;br&gt;graded → decision IS NOT NULL AND decision=accepted AND result_published_at IS NOT NULL. revision_required → decision IS NOT NULL AND decision=revision_required AND result_published_at IS NOT NULL.&lt;br&gt;CHECK состояния реализуется через CASE по status/decision либо ветки с явными IS NULL / IS NOT NULL: SQL UNKNOWN не должен обходить условную обязательность.&lt;br&gt;graded_at &amp;gt;= submitted_at, когда заполнен. result_published_at требует graded_at IS NOT NULL и &amp;gt;= graded_at. Публикация и статус — одним UPDATE; до неё score/feedback/decision скрыты от студента.&lt;br&gt;Переходы: submitted → under_review → graded или revision_required. Опубликованный результат в MVP не редактируется; история, повторные сдачи и административные правки отсутствуют." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="1260" y="640" width="1150" height="420" as="geometry" /></mxCell><mxCell id="rules_scores" parent="1" value="&lt;b&gt;5. Баллы, дашборд и доступ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Submissions.score — int. CHECK (score IS NULL OR score &amp;gt;= 0). Для accepted балл обязателен; NULL — нет балла, 0 — выставленный ноль.&lt;br&gt;Дашборд использует Assignments и опубликованные результаты Submissions. Неопубликованные результаты не попадают в студенческий API и расчёты.&lt;br&gt;Формула среднего балла, округление и учёт несданных/возвращённых работ согласуются в API; отдельное сохранённое поле среднего не требуется.&lt;br&gt;Студент видит свои задания/сдачи; куратор — разрешённые ему группы/работы. Права проверяются при каждом чтении и изменении, включая доступ к файлу." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="50" y="1090" width="1150" height="420" as="geometry" /></mxCell><mxCell id="rules_files" parent="1" value="&lt;b&gt;6. Файл хранится в PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Одна сдача содержит ровно один файл. file_data bytea NOT NULL; original_name, mime_type и size_bytes NOT NULL. original_name и mime_type непустые.&lt;br&gt;CHECK (size_bytes = octet_length(file_data)). CHECK (octet_length(file_data) BETWEEN 1 AND 20000000). Лимит — 20 000 000 байт, нулевой файл запрещён.&lt;br&gt;Сервер проверяет PDF, DOCX или ZIP по содержимому; расширения и MIME от браузера недостаточно. Время отправки — submitted_at; отдельной даты загрузки нет.&lt;br&gt;В списках выбирают метаданные без file_data. Содержимое получают отдельным запросом после проверки прав; не используют SELECT * для списков.&lt;br&gt;Индекс и уникальность на file_data не создаются. Одинаковые файлы в разных сдачах допустимы. bytea хранит байты, а не путь или URL.&lt;br&gt;При росте объёма учитывать размер БД и резервных копий. Внешнее хранилище — отдельное изменение требования, в эту модель не включено." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="1260" y="1090" width="1150" height="420" as="geometry" /></mxCell><mxCell id="rules_indexes" parent="1" value="&lt;b&gt;7. Типы, индексы и удаление&lt;/b&gt;&lt;br&gt;&lt;br&gt;Четыре id: int GENERATED ALWAYS AS IDENTITY PRIMARY KEY. Все восемь FK — int REFERENCES ... ON DELETE RESTRICT ON UPDATE RESTRICT. Связанные результаты каскадно не удаляются.&lt;br&gt;Все моменты событий — timestamptz. Даты группы — date. Сервер задаёт время; API использует ISO 8601 с UTC/смещением. Отображение часового пояса настраивается приложением.&lt;br&gt;UQ*: CREATE UNIQUE INDEX users_login_ci_uq ON Users (lower(btrim(login))); аналогично users_email_ci_uq по email. login/email NOT NULL, CHECK (btrim(login) &amp;lt;&amp;gt; &amp;#x27;&amp;#x27;) и аналогично email. Вход сравнивает по тому же выражению.&lt;br&gt;Обычный UQ по исходному text не заменяет эти индексы. citext/ENUM не требуются: текстовые роли/статусы ограничены CHECK. Сервер нормализует пробелы и регистр по той же политике.&lt;br&gt;Индексы: Users(group_id); Groups(curator_id); Assignments(group_id,status,deadline), (student_id,status,deadline), (curator_id); Submissions(student_id,status), (curator_id,status). Составной UQ покрывает assignment_id.&lt;br&gt;Пользователей деактивируют через is_active. Деактивация не должна оставлять действующую группу или незавершённую проверку без активного куратора; при таких зависимостях операция блокируется." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="50" y="1540" width="1150" height="420" as="geometry" /></mxCell><mxCell id="rules_scope" parent="1" value="&lt;b&gt;8. Объём и открытые решения MVP&lt;/b&gt;&lt;br&gt;&lt;br&gt;4 таблицы, 42 поля, 8 FK: Users, Groups, Assignments, Submissions. У студента одна группа; один курс — одна группа. Groups.student_id удалён как избыточный.&lt;br&gt;Файл и результат проверки находятся в Submissions. Нет отдельной таблицы файлов/оценок, истории попыток, апелляций, комментария студента и повторной отправки.&lt;br&gt;revision_required — опубликованное решение без новой отправки в MVP. Интерфейс должен объяснять это ограничение; добавление пересдачи требует изменения требований.&lt;br&gt;Вход через УрФУ отложен. Временный способ входа, создание аккаунтов и необходимость login/password_hash согласуются отдельно; существующие поля сохранены.&lt;br&gt;Приём после дедлайна и формула среднего остаются решениями API. Переносы между группами/смена куратора при существующих результатах требуют согласованной процедуры; до неё изменение блокируется.&lt;br&gt;«Функционал» и «Бизнес-процесс» — исходная аналитика нескольких этапов. Цветные блоки будущих этапов не расширяют текущий MVP. Это спецификация модели; SQL-миграции и сервер проверяются отдельно." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="1260" y="1540" width="1150" height="420" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>