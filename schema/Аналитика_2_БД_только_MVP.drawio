"1"><mxGeometry x="302" y="0" width="158" height="32" as="geometry"><mxRectangle x="0" y="0" width="158" height="32" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="v3__fk_submission_assignment" parent="1" value="Задание сдачи&lt;br&gt;1 : 0..N" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#2765A6;strokeWidth=2;fontColor=#2765A6;fontFamily=Arial;fontSize=16;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" source="v3__assignments_id" target="v3__submissions_assignment_id"><mxGeometry relative="1" as="geometry" x="0" y="0"><Array as="points"><mxPoint x="720" y="340" /><mxPoint x="720" y="372" /></Array><mxPoint x="-49.0" y="-32.0" as="offset" /></mxGeometry></mxCell><mxCell id="v3__fk_submission_student" parent="1" value="Автор сдачи&lt;br&gt;1 : 0..N" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#6F57A6;strokeWidth=2;fontColor=#6F57A6;fontFamily=Arial;fontSize=16;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" source="v3__users_id" target="v3__submissions_student_id"><mxGeometry relative="1" as="geometry" x="0" y="0"><Array as="points"><mxPoint x="680" y="990" /><mxPoint x="680" y="404" /></Array><mxPoint x="0.0" y="58.0" as="offset" /></mxGeometry></mxCell><mxCell id="v3__submission" parent="1" value="&lt;b&gt;Одна сдача на пару&lt;/b&gt;&lt;br&gt;&lt;br&gt;UNIQUE (assignment_id, student_id). Оба поля NOT NULL.&lt;br&gt;Повторная сдача и замена файла после отправки в MVP отсутствуют.&lt;br&gt;submitted_at — время атомарной отправки файла и сдачи; отдельного uploaded_at нет." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="1020" y="900" width="460" height="250" as="geometry" /></mxCell><mxCell id="v3__files_note" parent="1" value="&lt;b&gt;Файл хранится непосредственно в file_data&lt;/b&gt;&lt;br&gt;&lt;br&gt;file_data bytea, original_name, mime_type и size_bytes обязательны. Ровно один PDF, DOCX или ZIP; размер 1–20 000 000 байт.&lt;br&gt;size_bytes = octet_length(file_data). В списках получают только метаданные; содержимое читают отдельным запросом после проверки доступа." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="90" y="1340" width="1390" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="mvp-clear-4" name="4 Оценки"><mxGraphModel dx="1600" dy="1320" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v4__title" parent="1" value="4  Проверка и публикация результата" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=28;fontColor=#243A4B;fontStyle=1;" vertex="1"><mxGeometry x="60" y="25" width="1480" height="45" as="geometry" /></mxCell><mxCell id="v4__subtitle" parent="1" value="Назначенный куратор, балл, решение и обратная связь находятся в строке Submissions." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="60" y="78" width="1480" height="28" as="geometry" /></mxCell><mxCell id="v4__legend" parent="1" value="Стрелка: PK → FK. 1 : 0..N — у одной записи может быть много связанных. NULL — поле необязательно; NOT NULL — обязательно. UQ* — уникальность без учёта регистра." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=14;fontColor=#243A4B;" vertex="1"><mxGeometry x="60" y="115" width="1480" height="48" as="geometry" /></mxCell><mxCell id="v4__users" parent="1" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fillColor=#ffffff;strokeColor=#738596;fontFamily=Arial;fontSize=15;" vertex="1"><mxGeometry x="90" y="280" width="460" height="332" as="geometry" /></mxCell><mxCell id="v4__users_header" parent="v4__users" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fillColor=#4B6175;strokeColor=#B5C0C9;" vertex="1"><mxGeometry x="0" y="0" width="460" height="44" as="geometry" /></mxCell><mxCell id="v4__users_header_c0" parent="v4__users_header" value="Users / Пользователи" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontFamily=Arial;fontSize=17;fontColor=#FFFFFF;align=left;spacingLeft=8;fontStyle=1;colspan=3;" vertex="1" visible="1"><mxGeometry x="0" y="0" width="460" height="44" as="geometry"><mxRectangle x="0" y="0" width="106" height="44" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="v4__users_header_c1" parent="v4__users_header" value="" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontFamily=Arial;fontSize=17;fontColor=#FFFFFF;align=left;spacingLeft=8;" vertex="1" visible="0"><mxGeometry x="106" y="0" width="196" height="44" as="geometry"><mxRectangle x="0" y="0" width="196" height="44" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="v4__users_header_c2" parent="v4__users_header" value="" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=