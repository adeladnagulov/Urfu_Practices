mxGeometry x="0" y="204" width="460" height="32" as="geometry" /></mxCell><mxCell id="v1__groups_curator_id_c0" parent="v1__groups_curator_id" value="int" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontFamily=Arial;fontSize=15;fontColor=#172B3C;align=left;spacingLeft=8;" vertex="1" visible="1"><mxGeometry x="0" y="0" width="106" height="32" as="geometry"><mxRectangle x="0" y="0" width="106" height="32" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="v1__groups_curator_id_c1" parent="v1__groups_curator_id" value="curator_id" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontFamily=Arial;fontSize=15;fontColor=#172B3C;align=left;spacingLeft=8;" vertex="1" visible="1"><mxGeometry x="106" y="0" width="196" height="32" as="geometry"><mxRectangle x="0" y="0" width="196" height="32" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="v1__groups_curator_id_c2" parent="v1__groups_curator_id" value="FK, NOT NULL" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontFamily=Arial;fontSize=14;fontColor=#172B3C;align=left;spacingLeft=8;" vertex="1" visible="1"><mxGeometry x="302" y="0" width="158" height="32" as="geometry"><mxRectangle x="0" y="0" width="158" height="32" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="v1__fk_group_curator" parent="1" value="Куратор группы&lt;br&gt;1 : 0..N" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#7751A9;strokeWidth=2;fontColor=#7751A9;fontFamily=Arial;fontSize=16;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.25;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" source="v1__users_id" target="v1__groups_curator_id"><mxGeometry relative="1" as="geometry" x="0" y="0"><Array as="points"><mxPoint x="650" y="352" /><mxPoint x="650" y="190" /><mxPoint x="1530" y="190" /><mxPoint x="1530" y="520" /></Array><mxPoint x="-59.0" y="0.0" as="offset" /></mxGeometry></mxCell><mxCell id="v1__fk_user_group" parent="1" value="Студенты группы&lt;br&gt;1 : 0..N" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#087E83;strokeWidth=2;fontColor=#087E83;fontFamily=Arial;fontSize=16;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" source="v1__groups_id" target="v1__users_group_id"><mxGeometry relative="1" as="geometry" x="0" y="0"><Array as="points"><mxPoint x="820" y="360" /><mxPoint x="820" y="616" /></Array><mxPoint x="-90.0" y="93.0" as="offset" /></mxGeometry></mxCell><mxCell id="v1__explain" parent="1" value="&lt;b&gt;Две связи с разным смыслом&lt;/b&gt;&lt;br&gt;&lt;br&gt;Groups.curator_id → Users.id — кто курирует группу. Users.group_id → Groups.id — в какой группе учится студент.&lt;br&gt;Для role=student group_id обязателен; для curator/admin он NULL. Одна группа содержит много студентов; у студента одна группа.&lt;br&gt;Создание данных: куратор без group_id → группа с curator_id → студенты с group_id. Роли связанных пользователей проверяет сервер.&lt;br&gt;PK — первичный ключ. Четыре id выдаёт PostgreSQL через GENERATED ALWAYS AS IDENTITY. Все FK используют int." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="90" y="760" width="1390" height="230" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="mvp-clear-2" name="2 Задания"><mxGraphModel dx="1600" dy="1480" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1480" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v2__title" parent="1" value="2  Автор и получатель задания" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=28;fontColor=#243A4B;fontStyle=1;" vertex="1"><mxGeometry x="60" y="25" width="1480" height="45" as="geometry" /></mxCell><mxCell id="v2__subtitle" parent="1" value="Задание опубликовано для одной группы либо одного студента; черновик может быть без получателя." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="60" y="78" width="1480" height="28" as="geometry" /></mxCell><mxCell id="v2__legend" parent="1" value="Стрелка: PK → FK. 1 : 0..N — у одной записи может быть много связанных. NULL — поле необязательно; NOT NULL — обязательно. UQ* — уникальность без учёта регистра." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=14;fontColor=#243A4B;" vertex="1"><mxGeometry x="60" y="115" width="1480" height="48" as="geometry" /></mxCell><mxCell id="v2__users" parent="1" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fillColor=#ffffff;strokeColor=#738596;fontFamily=Arial;fontSize=15;" vertex="1"><mxGeometry x="90" y="300" width="460" height="332" as="geometry" /></mxCell><mxCell id="v2__users_header" parent="v2__users" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fillColor=#4B6175;strokeColor=#B5C0C9;" vertex="1"><mxGeometry x="0" y="0" width="460" height="44" as="geometry" /></mxCell><mxCell id="v2__users_header_c0" parent="v2__users_header" value="Users / Пользователи" style="sh