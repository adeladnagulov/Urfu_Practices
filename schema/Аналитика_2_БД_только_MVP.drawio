"32" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="v4__submissions_result_published_at" parent="v4__submissions" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fillColor=#FFFFFF;strokeColor=#B5C0C9;" vertex="1"><mxGeometry x="0" y="492" width="460" height="32" as="geometry" /></mxCell><mxCell id="v4__submissions_result_published_at_c0" parent="v4__submissions_result_published_at" value="timestamptz" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontFamily=Arial;fontSize=15;fontColor=#172B3C;align=left;spacingLeft=8;" vertex="1" visible="1"><mxGeometry x="0" y="0" width="106" height="32" as="geometry"><mxRectangle x="0" y="0" width="106" height="32" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="v4__submissions_result_published_at_c1" parent="v4__submissions_result_published_at" value="result_published_at" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontFamily=Arial;fontSize=15;fontColor=#172B3C;align=left;spacingLeft=8;" vertex="1" visible="1"><mxGeometry x="106" y="0" width="196" height="32" as="geometry"><mxRectangle x="0" y="0" width="196" height="32" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="v4__submissions_result_published_at_c2" parent="v4__submissions_result_published_at" value="NULL" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontFamily=Arial;fontSize=14;fontColor=#172B3C;align=left;spacingLeft=8;" vertex="1" visible="1"><mxGeometry x="302" y="0" width="158" height="32" as="geometry"><mxRectangle x="0" y="0" width="158" height="32" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="v4__fk_submission_curator" parent="1" value="Куратор проверки&lt;br&gt;1 : 0..N" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#3A7950;strokeWidth=2;fontColor=#3A7950;fontFamily=Arial;fontSize=16;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1;exitY=0.25;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" source="v4__users_id" target="v4__submissions_curator_id"><mxGeometry relative="1" as="geometry" x="0" y="0"><Array as="points"><mxPoint x="800" y="332" /><mxPoint x="800" y="628" /></Array><mxPoint x="0.0" y="35.0" as="offset" /></mxGeometry></mxCell><mxCell id="v4__review" parent="1" value="&lt;b&gt;Назначение и результат&lt;/b&gt;&lt;br&gt;&lt;br&gt;curator_id NOT NULL: сервер назначает куратора группы при отправке. Поле не означает завершённую проверку.&lt;br&gt;score — целый балл; feedback — обратная связь; decision — accepted или revision_required.&lt;br&gt;graded_at — сохранение подготовленного результата. result_published_at — открытие результата студенту." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="90" y="750" width="460" height="360" as="geometry" /></mxCell><mxCell id="v4__one_grade" parent="1" value="&lt;b&gt;До и после проверки&lt;/b&gt;&lt;br&gt;&lt;br&gt;submitted: пять полей результата NULL. under_review: результат может быть подготовлен, но result_published_at ещё NULL.&lt;br&gt;Публикация результата одновременно меняет статус на graded либо revision_required.&lt;br&gt;До публикации студент не получает score, feedback и decision. Повторной отправки после доработки в MVP нет." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#F8FAFC;strokeColor=#D4DFE6;fontFamily=Arial;fontSize=16;fontColor=#243A4B;" vertex="1"><mxGeometry x="1020" y="930" width="460" height="300" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="u_DbBrE8kGwYegofdpzG" name="Бизнес-процесс">
